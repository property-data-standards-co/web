direction: down

# Styling
*.style.border-radius: 8
*.style.font-size: 16

# Core entities (blue)
transaction: "Transaction\ndid:web:{platform}:transactions:{id}" {
  style.fill: "#1a5276"
  style.font-color: "#ffffff"
}

property: "Property\nurn:pdtf:uprn:{uprn}" {
  style.fill: "#2e86c1"
  style.font-color: "#ffffff"
}

title: "Title\nurn:pdtf:titleNumber:{n}" {
  style.fill: "#2e86c1"
  style.font-color: "#ffffff"
}

# Identity (green) — Person and Organisation
person: "Person\ndid:key" {
  style.fill: "#1a8a5c"
  style.font-color: "#ffffff"
}

organisation: "Organisation\ndid:key or did:web" {
  style.fill: "#148f77"
  style.font-color: "#ffffff"
}

# Seller-side relationship credentials (gold, rounded) — held on the Transaction
sellerCapacity: "SellerCapacity\nurn:pdtf:capacity:{id}" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

representation: "Representation\nsellerConveyancer / estateAgent" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

# Offer (purple) — the intent to buy. Self-contained: it NESTS its own
# buyer-side relationship credentials.
offer: "Offer  ·  urn:pdtf:offer:{id}" {
  style.fill: "#7d3c98"
  style.font-color: "#ffffff"

  buyerRep: "Representation\nbuyerConveyancer / buyerAgent" {
    style.fill: "#f1c40f"
    style.font-color: "#1a1a1a"
    style.border-radius: 16
  }
  consent: "DelegatedConsent\nurn:pdtf:consent:{id}" {
    style.fill: "#f1c40f"
    style.font-color: "#1a1a1a"
    style.border-radius: 16
  }
}

# Transaction → core entities
transaction -> property: "properties{}" {
  style.stroke: "#2e86c1"
  style.stroke-width: 2
}
transaction -> title: "titles{}" {
  style.stroke: "#2e86c1"
  style.stroke-width: 2
}

# Transaction → seller-side relationship credentials
transaction -> sellerCapacity: "ownership{}" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}
transaction -> representation: "representation{}" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}

# Transaction → offers (which nest the buyer-side credentials)
transaction -> offer: "offers{}" {
  style.stroke: "#7d3c98"
  style.stroke-width: 2
}

# SellerCapacity links Person/Org to Title (the right to sell)
sellerCapacity -> person: "owner (Person)" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
sellerCapacity -> organisation: "owner (Org)" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}
sellerCapacity -> title: "asserts ownership of" {
  style.stroke: "#2e86c1"
  style.stroke-width: 2
}

# Seller-side Representation → the instructed Organisation
representation -> organisation: "holder" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}

# Offer → buyer Person(s); nested credentials → their Organisations
offer -> person: "buyerIds []" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
offer.buyerRep -> organisation: "holder" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}
offer.consent -> organisation: "authorises" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}

# Property ↔ Title (optional link)
property -> title: "may have" {
  style.stroke: "#2e86c1"
  style.stroke-width: 1
  style.stroke-dash: 5
}
