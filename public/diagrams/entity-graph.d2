direction: down

# Styling
*.style.border-radius: 8
*.style.font-size: 16

# Data entities (blue)
transaction: "Transaction\ndid:web:{platform}:transactions:{id}\nroster: participants[] — DID, local id, firm. No roles." {
  style.fill: "#1a5276"
  style.font-color: "#ffffff"
}

property: "Property\nurn:pdtf:uprn:{uprn}" {
  style.fill: "#2e86c1"
  style.font-color: "#ffffff"
}

title: "Title\nurn:pdtf:titleNumber:{n}" {
  style.fill: "#2e86c1"
  style.font-color: "#ffffff"
}

# Identity (green) — Person and Organisation
person: "Person\ndid:key (stable across transactions)" {
  style.fill: "#1a8a5c"
  style.font-color: "#ffffff"
}

organisation: "Organisation\ndid:web" {
  style.fill: "#148f77"
  style.font-color: "#ffffff"
}

# Relationship credentials (gold, rounded). Each embodies a role and
# references the Transaction. Role is stored nowhere else.
sellerCapacity: "SellerCapacity\nurn:pdtf:capacity:{id}\n⇒ Seller" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

offer: "Offer\nurn:pdtf:offer:{id}\n⇒ Buyer" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

gift: "Gift\nurn:pdtf:gift:{id}\n⇒ Giftor" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

representation: "Representation\nurn:pdtf:representation:{id}\nrole: conveyancer / agent / broker…" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

transactionRole: "TransactionRole\nurn:pdtf:role:{id}\nrole: lender / landlord / tenant…" {
  style.fill: "#f1c40f"
  style.font-color: "#1a1a1a"
  style.border-radius: 16
}

# Transaction → data entities
transaction -> property: "property" {
  style.stroke: "#2e86c1"
  style.stroke-width: 2
}
transaction -> title: "titlesToBeSold[]" {
  style.stroke: "#2e86c1"
  style.stroke-width: 2
}
transaction -> person: "participants[]" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
transaction -> organisation: "participants[]" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}

# Relationship credentials → Transaction
sellerCapacity -> transaction: "transaction" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}
offer -> transaction: "transaction + offerId" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}
gift -> transaction: "transaction + offerId" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}
representation -> transaction: "transaction" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}
transactionRole -> transaction: "transaction" {
  style.stroke: "#d4ac0d"
  style.stroke-width: 2
}

# Relationship credentials → the parties they name
sellerCapacity -> person: "seller" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
sellerCapacity -> title: "title (optional)" {
  style.stroke: "#2e86c1"
  style.stroke-width: 1
  style.stroke-dash: 5
}
offer -> person: "buyer" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
gift -> person: "donor" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
representation -> person: "representative / representedParty" {
  style.stroke: "#1a8a5c"
  style.stroke-width: 2
}
representation -> organisation: "representative (firm)" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}
transactionRole -> organisation: "participant" {
  style.stroke: "#148f77"
  style.stroke-width: 2
}

# Property ↔ Title (optional link)
property -> title: "may have" {
  style.stroke: "#2e86c1"
  style.stroke-width: 1
  style.stroke-dash: 5
}
