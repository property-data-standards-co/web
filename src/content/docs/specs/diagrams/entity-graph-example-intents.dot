// PDTF entity graph — worked example, radial layout.
// Render:  twopi -Tsvg entity-graph-example-intents.dot -o entity-graph-example-intents.svg
//          twopi -Tpng -Gdpi=192 entity-graph-example-intents.dot -o entity-graph-example-intents.png
//
// Model (architecture/entities.md §"Roles live on the credentials"):
//   The Transaction keeps a roster of parties (DID, local id, firm) but no roles.
//   Every relationship credential references the Transaction and embodies a role:
//     SellerCapacity ⇒ Seller, Offer ⇒ Buyer, Gift ⇒ Giftor,
//     Representation (role: which kind), TransactionRole (role: which role).
//   Revoking a credential removes the role with it.

digraph pdtf {
  layout   = twopi;
  root     = transaction;
  ranksep  = "1.9 equally";
  overlap  = false;
  splines  = true;
  bgcolor  = "white";
  fontname = "Helvetica";

  node [shape=box, style="rounded,filled", fontname="Helvetica",
        fontsize=13, margin="0.14,0.09", penwidth=0];
  edge [fontname="Helvetica", fontsize=10, color="#95a5a6",
        fontcolor="#566573", arrowsize=0.7, penwidth=1.4];

  // ── The sale ────────────────────────────────────────
  transaction [label="Transaction\n14 Elm Road sale\nroster: 7 parties, no roles", fillcolor="#1a5276", fontcolor="white", fontsize=15];

  // ── Data entities (blue) ────────────────────────────
  property [label="Property\n14 Elm Road, Bristol", fillcolor="#2e86c1", fontcolor="white"];
  title    [label="Title BL54321\nFreehold",        fillcolor="#2e86c1", fontcolor="white"];

  // ── Relationship credentials (gold) ─────────────────
  capacity  [label="SellerCapacity\nLegal Owner  ⇒ Seller",      fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  offer     [label="Offer\n£450,000 · Accepted  ⇒ Buyer",       fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  gift      [label="Gift\n£50,000 towards offer  ⇒ Giftor",     fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  repSeller [label="Representation\nSeller's Conveyancer",      fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  repAgent  [label="Representation\nEstate Agent",              fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  repBuyer  [label="Representation\nBuyer's Conveyancer",       fillcolor="#f1c40f", fontcolor="#1a1a1a"];
  roleLender [label="TransactionRole\nLender",                  fillcolor="#f1c40f", fontcolor="#1a1a1a"];

  // ── People (green) & Organisations (teal) ───────────
  john         [label="John Smith",                       fillcolor="#1a8a5c", fontcolor="white"];
  sarah        [label="Sarah Patel",                      fillcolor="#1a8a5c", fontcolor="white"];
  priya        [label="Priya Patel",                      fillcolor="#1a8a5c", fontcolor="white"];
  smithco      [label="Smith & Co Law",                   fillcolor="#148f77", fontcolor="white"];
  bristolhomes [label="Bristol Homes",                    fillcolor="#148f77", fontcolor="white"];
  joneslegal   [label="Jones Legal",                      fillcolor="#148f77", fontcolor="white"];
  bigbank      [label="Big Bank plc",                     fillcolor="#148f77", fontcolor="white"];

  // ── Digital identity (slate) ────────────────────────
  johnId  [label="Digital ID\nGOV.UK One Login",       fillcolor="#34495e", fontcolor="white"];
  sarahId [label="Digital ID\nreused from prior sale", fillcolor="#34495e", fontcolor="white"];

  // ══ Data entities ══
  transaction -> property  [label="property",        color="#2e86c1"];
  transaction -> title     [label="titlesToBeSold[]", color="#2e86c1"];

  // ══ Relationship credentials, each referencing the Transaction ══
  transaction -> capacity   [color="#d4ac0d", dir=back];
  transaction -> offer      [color="#d4ac0d", dir=back, penwidth=2.2];
  transaction -> gift       [color="#d4ac0d", dir=back];
  transaction -> repSeller  [color="#d4ac0d", dir=back];
  transaction -> repAgent   [color="#d4ac0d", dir=back];
  transaction -> repBuyer   [color="#d4ac0d", dir=back];
  transaction -> roleLender [color="#d4ac0d", dir=back];

  // ══ Who each credential names ══
  capacity  -> john         [label="seller",            color="#1a8a5c"];
  offer     -> sarah        [label="buyer",             color="#1a8a5c", penwidth=2];
  gift      -> priya        [label="donor",             color="#1a8a5c"];
  gift      -> offer        [label="offerId",           color="#d4ac0d", constraint=false, style=dashed];
  repSeller -> smithco      [label="representative",    color="#148f77"];
  repSeller -> john         [label="representedParty",  color="#1a8a5c", constraint=false, style=dashed];
  repAgent  -> bristolhomes [label="representative",    color="#148f77"];
  repAgent  -> john         [label="representedParty",  color="#1a8a5c", constraint=false, style=dashed];
  repBuyer  -> joneslegal   [label="representative",    color="#148f77"];
  repBuyer  -> sarah        [label="representedParty",  color="#1a8a5c", constraint=false, style=dashed];
  roleLender -> bigbank     [label="participant",       color="#148f77"];

  john  -> johnId  [label="identityBinding", color="#34495e"];
  sarah -> sarahId [label="identityBinding", color="#34495e"];
}
